{
  "apiVersion": 1,
  "id": "midnight.examples.persistent-light",
  "version": "1.0.0",
  "runtimeProfile": "juce-small-js-v1",
  "entry": "main.js",
  "lifetime": "persistent",
  "parameters": [
    {
      "id": "threshold",
      "type": "number",
      "default": 0.5,
      "min": 0,
      "max": 1
    },
    {
      "id": "brightness",
      "type": "number",
      "default": 0.8,
      "min": 0,
      "max": 1
    }
  ],
  "inputs": [
    {
      "alias": "sensor",
      "type": "number",
      "scope": "live"
    }
  ],
  "commands": [
    {
      "alias": "light",
      "operation": "setValue"
    }
  ],
  "capabilities": [
    "read:sensor",
    "write:light",
    "status",
    "hostTimer"
  ],
  "assets": [],
  "dependencies": []
}
